# Copy to .env.local for local development. Every value is optional: without
# them Visio runs its rule-based agent and a clearly labeled demo checkout.

# PayPal Developer Dashboard > Apps & Credentials > Sandbox app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox app > Webhooks > the id of the webhook pointing at /api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# https://console.groq.com/keys
GROQ_API_KEY=
# Optional override; defaults to llama-3.3-70b-versatile
GROQ_MODEL=

# Optional, at least 32 characters. If unset, a random key is generated once and
# stored in the app database.
TRUST_GATE_SECRET=
